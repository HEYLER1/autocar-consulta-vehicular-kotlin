<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/multi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/navy"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/multi_back"
            android:layout_width="52dp"
            android:layout_height="match_parent"
            android:contentDescription="Volver"
            android:gravity="center"
            android:text="‹"
            android:textColor="@color/brand_yellow"
            android:textSize="40sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Consulta múltiple"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/multi_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Preparando 4 portales…"
                android:textColor="#C7D6E8"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/multi_plate"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_scan_button"
            android:gravity="center"
            android:paddingStart="13dp"
            android:paddingEnd="13dp"
            android:textColor="@color/navy"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/multi_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/brand_yellow" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_soft"
        android:paddingStart="18dp"
        android:paddingTop="10dp"
        android:paddingEnd="18dp"
        android:paddingBottom="10dp"
        android:text="Los portales se cargan a la vez. Las verificaciones necesarias aparecen juntas."
        android:textColor="@color/navy"
        android:textSize="11sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_round_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Informe para la compra"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/purchase_verdict"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="INFORME EN CURSO · 0/4 fuentes"
            android:textColor="@color/navy"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView android:id="@+id/result_sunarp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:drawablePadding="8dp" android:maxLines="2" android:text="SUNARP · Consultando…" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView android:id="@+id/result_soat" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="2" android:text="SOAT · Consultando…" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView android:id="@+id/result_sutran" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="2" android:text="SUTRAN · Consultando…" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <TextView android:id="@+id/result_mtc" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="2" android:text="MTC · Consultando…" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <Button
            android:id="@+id/open_soat_source"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="VER SOAT · FUENTE SBS"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/captcha_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_round_card"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verificación única"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/captcha_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Escribe los códigos y continúa una sola vez."
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:text="SOAT"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/captcha_soat_image"
                android:layout_width="110dp"
                android:layout_height="46dp"
                android:background="#F5F7FA"
                android:contentDescription="Código captcha de SOAT"
                android:scaleType="fitCenter" />

            <EditText
                android:id="@+id/captcha_soat_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Código"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters"
                android:maxLength="8"
                android:singleLine="true"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:text="SUTRAN"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/captcha_sutran_image"
                android:layout_width="110dp"
                android:layout_height="46dp"
                android:background="#F5F7FA"
                android:contentDescription="Código captcha de SUTRAN"
                android:scaleType="fitCenter" />

            <EditText
                android:id="@+id/captcha_sutran_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Código"
                android:imeOptions="actionNext"
                android:inputType="textCapCharacters"
                android:maxLength="4"
                android:singleLine="true"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="62dp"
                android:layout_height="wrap_content"
                android:text="MTC"
                android:textColor="@color/navy"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/captcha_mtc_image"
                android:layout_width="110dp"
                android:layout_height="46dp"
                android:background="#F5F7FA"
                android:contentDescription="Código captcha del MTC"
                android:scaleType="fitCenter" />

            <EditText
                android:id="@+id/captcha_mtc_input"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:hint="Código"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:maxLength="6"
                android:singleLine="true"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/captcha_submit"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/brand_yellow"
            android:text="CONTINUAR CONSULTA"
            android:textColor="@color/navy"
            android:textStyle="bold" />
    </LinearLayout>

    </LinearLayout>
    </ScrollView>
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView android:id="@+id/tab_sunarp" android:layout_width="wrap_content" android:layout_height="42dp" android:gravity="center" android:minWidth="112dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="SUNARP  ···" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tab_soat" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:gravity="center" android:minWidth="96dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="SOAT  ···" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tab_sutran" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:gravity="center" android:minWidth="108dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="SUTRAN  ···" android:textSize="12sp" android:textStyle="bold" />
            <TextView android:id="@+id/tab_mtc" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="8dp" android:gravity="center" android:minWidth="92dp" android:paddingStart="15dp" android:paddingEnd="15dp" android:text="MTC  ···" android:textSize="12sp" android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/multi_web_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center"
        android:padding="9dp"
        android:text="Solo necesitas escribir los códigos mostrados en Verificación única."
        android:textColor="@color/text_secondary"
        android:textSize="10sp" />
</LinearLayout>
